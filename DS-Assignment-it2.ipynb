   "cell_type": "code",
   "execution_count": 22,
   "id": "87f4fc0f",
   "metadata": {},
   "outputs": [],
   "source": [
    "target = df_merged[\"Hull_Integrity\"]\n",
    "\n",
    "features = df_merged[[\"Reactor_Power\", \"Propulsion_Type\", \"Ship_Class\", \"Galactic_Credits\", \"Model_Cycle\"]]\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c2d18731",
   "metadata": {},
   "source": [
    "We have decided not to use the test and train split, since we aren't training the model, but it's a manual classification."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "f94bad23",
   "metadata": {},
   "outputs": [],
   "source": [
    "value = \"Operational\"\n",
    "\n",
    "prediction = [value] * len(target)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "6c760946",
   "metadata": {},
   "outputs": [
